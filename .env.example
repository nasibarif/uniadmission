# UniAdmission Environment Configuration
# Copy this file to .env and replace the placeholder values with your real project credentials.

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Gemini API Key (Server Secret Only)
# Stored securely on your server/Supabase Edge Function environment variables.
# NEVER expose this key to browser bundles or prefix with VITE_.
GEMINI_API_KEY=
