# ============================================================================
# UniAdmission Environment Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Supabase Public Client (Frontend)
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ----------------------------------------------------------------------------
# 2. Server-Side AI Gateway (Never expose via VITE_*)
# ----------------------------------------------------------------------------
GEMINI_API_KEY=your-google-gemini-api-key

# ----------------------------------------------------------------------------
# 3. Server-Side bKash MFS Gateway (Strictly Server / Edge Functions Only)
# Stripe is excluded from scope. All payments are processed in Bangladeshi Taka (BDT).
# ----------------------------------------------------------------------------
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v2.0
BKASH_APP_KEY=your-bkash-app-key
BKASH_APP_SECRET=your-bkash-app-secret
BKASH_USERNAME=your-bkash-username
BKASH_PASSWORD=your-bkash-password
BKASH_CALLBACK_URL=https://app.uniadmission.com/api/bkash/callback
